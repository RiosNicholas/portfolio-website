# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
# This now signs the session JWT itself (not just OAuth state) — rotating it
# signs everyone out.
AUTH_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/portfolio-website"
# Direct (non-pooled) connection, used by `prisma migrate`. Same value as
# DATABASE_URL for local dev; on Vercel Postgres this is
# POSTGRES_URL_NON_POOLING while DATABASE_URL is POSTGRES_PRISMA_URL.
DIRECT_URL="postgresql://postgres:password@localhost:5432/portfolio-website"

# Credentials-based admin access
# ADMIN_USERNAME is a free choice — anything non-empty. ADMIN_PASSWORD_HASH
# is generated by `npm run auth:hash` (never paste the plaintext password
# here); the expected format is `scrypt:<salt>:<key>`, validated by a regex
# in `src/env.js`. Both must stay non-empty — `src/env.js` uses
# `emptyStringAsUndefined: true`, so `""` fails the build the same as
# leaving the var unset. Changing either requires a dev-server restart to
# take effect.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
