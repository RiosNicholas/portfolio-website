// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    // Neon Postgres: the pooled connection above is used at runtime;
    // migrations need a direct (non-pooled) connection. Locally both env
    // vars can point at the same start-database.sh Postgres. On Vercel,
    // set DIRECT_URL = DATABASE_URL_UNPOOLED after connecting the Neon
    // integration (one-time manual mapping in the project's env var
    // settings - see README.md "Deploying").
    directUrl = env("DIRECT_URL")
}

enum CvCategory {
    EXPERIENCE
    EDUCATION
    ACTIVITY
    AWARD
}

enum SkillKind {
    SKILL
    TOOL
}

model CaseStudy {
    id          String   @id // reuse existing slugs verbatim ("risk-agents", "evangeliu", ...) -
    // load-bearing as /work#<id> anchors in case-study.tsx / work-teaser.tsx
    num         String
    year        String?
    startYear   Int?
    startMonth  Int?
    endYear     Int?
    endMonth    Int?
    present     Boolean  @default(false)
    title       String
    titleEm     String?
    titleSuffix String?
    role        String
    org         String
    description String
    tags        String[]
    stats       Json // CaseStat[] ({k,v}); exactly-3 invariant enforced by Zod in the router input, not the DB
    featured    Boolean  @default(false)
    sortOrder   Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([featured])
}

model Endorsement {
    id          String   @id @default(cuid())
    name        String
    role        String
    quote       String
    linkedinUrl String // deliberately not unique -- a person could get a second quote card in the future
    avatarUrl   String?
    published   Boolean  @default(true) // lets admin stage a pasted-in recommendation before it goes live
    sortOrder   Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([published])
}

model CvEntry {
    id          String     @id @default(cuid())
    category    CvCategory
    years       String?
    startYear   Int?
    startMonth  Int?
    endYear     Int?
    endMonth    Int?
    present     Boolean    @default(false)
    title       String
    titleAccent String[]
    where       String
    sortOrder   Int        @default(0)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@index([category, sortOrder])
}

model Skill {
    id        String    @id @default(cuid())
    kind      SkillKind
    label     String
    accent    String?
    sortOrder Int       @default(0)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@index([kind, sortOrder])
}

model Language {
    id        String   @id @default(cuid())
    name      String   @unique // natural key - seed upserts by this
    level     String
    published Boolean  @default(true)
    sortOrder Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([published, sortOrder])
}

model Article {
    id          String    @id @default(cuid())
    slug        String    @unique
    title       String
    summary     String
    body        String // Markdown, rendered on the server
    tags        String[] // source tags, free text
    published   Boolean   @default(false)
    publishedAt DateTime? // set the first time the article is published
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@index([published, publishedAt])
}

model Mention {
    id          String   @id @default(cuid())
    url         String
    title       String
    outlet      String
    publishedAt DateTime
    tags        String[]
    published   Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([published, publishedAt])
}

model Profile {
    id           String   @id @default("profile")
    intro        String
    summary      String
    status       String
    city         String
    region       String
    employer     String
    team         String
    projectsLede String
    writingLede  String
    contactLede  String
    updatedAt    DateTime @updatedAt
}
