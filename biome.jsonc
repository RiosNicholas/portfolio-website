{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"useIgnoreFile": true,
		"clientKind": "git"
	},
	"files": {
		"includes": ["**", "!generated"]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": true,
			"source": {
				"recommended": true,
				"organizeImports": "on",
				"useSortedAttributes": "on"
			}
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				// `data-motion="low"` must forcibly beat inline Framer Motion
				// styles, and `.geo-tri`/`.geo-dotsq` shape rules must beat
				// Tailwind width/height/background utilities — both are
				// load-bearing, not accidental cascade fights.
				"noImportantStyles": "off"
			},
			"suspicious": {
				// Static/doubled arrays where index is the only stable key
				"noArrayIndexKey": "off"
			},
			"security": {
				// SVG content is hardcoded, not user input
				"noDangerouslySetInnerHtml": "off"
			},
			"nursery": {
				"useImportsFirst": "warn",
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": {
						"functions": ["clsx", "cva", "cn"]
					}
				}
			}
		}
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"css": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	}
}
